{
  "name": "ilo-mcp-server",
  "private": true,
  "version": "0.2.0",
  "description": "Servidor MCP provenance-first para o ILOSTAT (estatísticas de trabalho da OIT) — Cloudflare Workers, SDMX REST, contrato de proveniência v1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
