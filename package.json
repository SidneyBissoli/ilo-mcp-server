    "seed:sql": "node scripts/seed-catalog.mjs",
    "eval": "tsx evals/run.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@sbissoli/mcp-provenance": "^0.1.0",
    "agents": "^0.21.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260818.1",
    "@sbissoli/mcp-evals": "^0.1.0",
    "tsx": "^4.23.12",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.124.0"
  }
}
