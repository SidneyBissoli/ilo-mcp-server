{"name":"ilo-mcp-server","version":"0.6.0","mcpName":"io.github.SidneyBissoli/ilo-mcp-server","license":"MIT","description":"Remote MCP server for ILOSTAT, the ILO labour statistics database: unemployment, employment, earnings (wages), working time and informality by country, year, sex and age — hosted, nothing to install, no API key, with source URL, data vintage, retrieval timestamp and licence on every answer. Everyday and US wording (labor, wages, informality) is resolved to the ILO's own. Also runs locally over stdio.","homepage":"https://ilo.sidneybissoli.com","repository":{"type":"git","url":"git+https://github.com/SidneyBissoli/ilo-mcp-server.git"},"bugs":{"url":"https://github.com/SidneyBissoli/ilo-mcp-server/issues"},"author":"Sidney da S. P. Bissoli <sbissoli76@gmail.com>","keywords":["mcp","model-context-protocol","mcp-server","remote-mcp-server","ilo","ilostat","labour-statistics","labor-statistics","labour-market","labor-market","unemployment","employment","wages","earnings","informality","working-time","sdmx","official-statistics","open-data","provenance"],"engines":{"node":">=22"},"type":"module","bin":{"ilo-mcp-server":"dist/cli.js"},"files":["dist","README.md","LICENSE.md"],"scripts":{"version":"node scripts/sync-version.mjs && git add -u","dev":"wrangler dev","build":"tsc -p tsconfig.build.json","start":"node dist/cli.js","deploy":"wrangler deploy","typecheck":"tsc --noEmit","test":"vitest run","seed:sql":"node scripts/seed-catalog.mjs","manifest:lhm":"tsx scripts/gen-lhm-manifest.mts","eval":"tsx evals/run.ts"},"dependencies":{"@modelcontextprotocol/server":"^2.0.0","@sbissoli/mcp-provenance":"^0.1.0","@sbissoli/mcp-search":"^0.4.0","zod":"^4.5.4"},"devDependencies":{"@cloudflare/workers-types":"^5.20260904.1","@modelcontextprotocol/client":"^2.0.0","@sbissoli/mcp-evals":"^0.1.0","@types/node":"^26.4.1","agents":"^0.22.0","tsx":"^4.23.13","typescript":"^7.0.2","vite":"^8.2.2","vitest":"^5.0.0","wrangler":"^4.129.0"},"overrides":{"sharp":"^0.35.4"