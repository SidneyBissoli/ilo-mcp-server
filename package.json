{"name":"ilo-mcp-server","version":"1.7.0","mcpName":"io.github.SidneyBissoli/ilo-mcp-server","license":"MIT","description":"Remote MCP server for ILOSTAT, the ILO labour statistics database: unemployment, employment, earnings (wages), working time and informality by country, year, sex and age — hosted, nothing to install, no API key, with source URL, data vintage, retrieval timestamp and licence on every answer. Everyday and US wording (labor, wages, informality) is resolved to the ILO's own. Also runs locally over stdio.","homepage":"https://ilo.sidneybissoli.com","repository":{"type":"git","url":"git+https://github.com/SidneyBissoli/ilo-mcp-server.git"},"bugs":{"url":"https://github.com/SidneyBissoli/ilo-mcp-server/issues"},"author":"Sidney da Silva Pereira Bissoli <sbissoli76@gmail.com>","keywords":["mcp","model-context-protocol","mcp-server","remote-mcp-server","ilo","ilostat","labour-statistics","labor-statistics","labour-market","labor-market","unemployment","employment","wages","earnings","informality","working-time","sdmx","official-statistics","open-data","provenance"],"engines":{"node":">=22"},"type":"module","bin":{"ilo-mcp-server":"dist/cli.js"},"files":["dist","README.md","LICENSE.md"],"scripts":{"version":"node scripts/sync-version.mjs && git add -u","dev":"wrangler dev","build":"tsc -p tsconfig.build.json","start":"node dist/cli.js","deploy":"wrangler deploy","typecheck":"tsc --noEmit","test":"vitest run","surface:lock":"mcp-surface travar --cmd \"vitest run tests/surface-lock.test.ts\" && mcp-surface registro --tool ilo_search_indicators --args \"{\\\"query\\\":\\\"unemployment\\\"}\"","seed:sql":"node scripts/seed-catalog.mjs","manifest:lhm":"tsx scripts/gen-lhm-manifest.mts","eval":"tsx evals/run.ts"},"dependencies":{"@modelcontextprotocol/server":"^2.4.0","@sbissoli/mcp-provenance":"^0.4.0","@sbissoli/mcp-search":"^0.9.1","@sbissoli/mcp-upstream":"^0.5.1","zod":"^4.6.7"},"devDependencies":{"@cloudflare/workers-types":"^5.20261024.1","@modelcontex