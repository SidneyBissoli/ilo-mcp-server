{
  "name": "ilo-mcp-server",
  "version": "0.4.0",
  "mcpName": "io.github.SidneyBissoli/ilo-mcp-server",
  "license": "MIT",
  "description": "Provenance-first MCP server for ILOSTAT (ILO labour statistics): search indicators and retrieve labour data by country, year, sex and age, with source URL, data vintage, retrieval timestamp and license on every response. Hosted on Cloudflare Workers (Streamable HTTP) or local stdio.",
  "homepage": "https://ilo.sidneybissoli.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SidneyBissoli/ilo-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/SidneyBissoli/ilo-mcp-server/issues"
  },
  "author": "Sidney da S. P. Bissoli <sbissoli76@gmail.com>",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "ilo",
    "ilostat",
    "labour-statistics",
    "labor",
    "unemployment",
    "employment",
    "wages",
    "sdmx",
    "open-data",
    "provenance"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "bin": {
    "ilo-mcp-server": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "scripts": {
    "version": "node scripts/sync-version.mjs && git add -u",
    "dev": "wrangler dev",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/cli.js",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed:sql": "node scripts/seed-catalog.mjs",
    "manifest:lhm": "tsx scripts/gen-lhm-manifest.mts",
    "eval": "tsx evals/run.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@sbissoli/mcp-provenance": "^0.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260827.1",
    "@modelcontextprotocol/client": "^2.0.0",
    "@sbissoli/mcp-evals": "^0.1.0",
    "@types/node": "^26.4.0",
    "agents": "^0.22.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.0"
  }
}
