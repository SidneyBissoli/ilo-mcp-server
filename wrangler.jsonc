// Configuração do Worker — servidor MCP ILOSTAT (Fase 1 do projeto ilostat).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ilo-mcp-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-07",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,

  // Domínio próprio (padrão das URLs do portfólio). Hostname também listado em
  // SERVER_CONFIG.extraAllowedHostnames — o createMcpHandler valida o header Host.
  "routes": [{ "pattern": "ilo.sidneybissoli.com", "custom_domain": true }],

  "vars": {
    "ALLOWED_ORIGIN": "*"
  },

  // Cache SDMX: codelists cacheadas POR CODELIST (CL_MEASURE/CL_AREA são compartilhadas
  // entre dataflows — ~90% de economia, medição do spike) + estrutura de dataflow.
  "kv_namespaces": [
    { "binding": "SDMX_CACHE", "id": "e34b3945586c4072a3d54465fe41e455" }
  ],

  // Catálogo de dataflows (1.210 / 557 KB, medição do spike) — busca de indicadores
  // 100% local, sem chamada ao upstream. Seed: scripts/seed-catalog.mjs.
  "d1_databases": [
    { "binding": "CATALOG_DB", "database_name": "ilostat-catalog", "database_id": "a4a11eaa-574b-446b-a0b0-d584b467f3b3" }
  ],

  // Estatísticas de uso — Durable Object singleton com storage SQLite (src/usage.ts).
  "durable_objects": {
    "bindings": [{ "name": "USAGE", "class_name": "UsageTracker" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UsageTracker"] }],

  // Telemetria de tool calls — tool/desfecho/país/AS/marcador self por chamada,
  // consultável via SQL API do Analytics Engine. O dataset é criado no primeiro
  // writeDataPoint. Esquema (privacy-scoped) em src/analytics.ts.
  "analytics_engine_datasets": [
    { "binding": "ANALYTICS", "dataset": "ilo_mcp_tool_calls" }
  ],

  // Metadados do último deploy (id/tag/timestamp) — expostos em GET /status.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },

  // Logs estruturados no painel da Cloudflare (Workers Logs).
  "observability": { "enabled": true }
}
